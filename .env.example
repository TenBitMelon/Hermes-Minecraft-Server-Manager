# Copy to .env and fill in.

# ---------------------------------------------------------------------------
# Public origin and DNS
# ---------------------------------------------------------------------------

# Origin the web interface is served from, including the scheme. Used for the
# SvelteKit CSRF check and for building server icon URLs.
PUBLIC_APP_ORIGIN=https://servers.example.com

# DNS suffix that Minecraft servers are created under. No scheme.
#   example.com            -> sand.example.com
#   servers.example.com    -> sand.servers.example.com
PUBLIC_SERVER_BASE_DOMAIN=example.com

# ---------------------------------------------------------------------------
# Server defaults
# ---------------------------------------------------------------------------

# Default icon for servers that do not upload one.
PUBLIC_DEFAULT_ICON_URL=https://example.com/icon.png

# MOTD used when the create form is left blank. No colour codes.
PUBLIC_DEFAULT_MOTD=A Hermes Minecraft Server

# Hours a stopped server is kept before deletion. Use -1 to keep servers forever.
PUBLIC_TIME_UNTIL_DELETION_AFTER_SHUTDOWN=168

# Require every created server to ship with a whitelist enabled.
PUBLIC_REQUIRE_WHITELIST=true

# Comma-separated auth providers the UI may offer. Supported: github, google,
# authentik. Order is preserved and becomes the button order.
PUBLIC_AUTH_PROVIDERS=github,google

# ---------------------------------------------------------------------------
# Local runtime ports
# ---------------------------------------------------------------------------

# Inclusive port range used when a server runs on this host.
PORT_MIN=25563
PORT_MAX=25564

# Skip the default Minecraft port. Helps keep servers from being found by
# scanners.
AVOID_DEFAULT_PORT=true

# ---------------------------------------------------------------------------
# Cloudflare
# ---------------------------------------------------------------------------

# API token with permission to edit DNS records in the zone below.
CLOUDFLARE_TOKEN=

# Zone id for the zone that PUBLIC_SERVER_BASE_DOMAIN lives in.
CLOUDFLARE_ZONE_ID=

# ---------------------------------------------------------------------------
# PocketBase
# ---------------------------------------------------------------------------

# Hermes authenticates to PocketBase as the superuser on the server side. If
# these are unset the database will not start automatically.
POCKETBASE_INTERNAL_ADMIN_EMAIL=
POCKETBASE_INTERNAL_ADMIN_PASSWORD=

# ---------------------------------------------------------------------------
# Hermes roles
#
# The HERMES_* variables are split by which process reads them. Setting one on the
# wrong process is not an error: it is read by nothing and silently ignored, so
# check the heading before copying a value anywhere.
# ---------------------------------------------------------------------------

## Read by every process, to know which half it is

#   control  web UI, database, Cloudflare. Does not host game servers.
#   worker   game servers only. Dials the control plane and hosts containers.
#   hybrid   both. The default, and what a single-machine install uses.
HERMES_RUNTIME_ROLE=hybrid

## Control plane only

# How stale a worker heartbeat may get before the control plane calls the worker
# offline, and how stale before it is called restarting rather than healthy.
#
# These belong here, not on the worker. A worker reports counts and a version and
# never a status, because judging liveness needs the heartbeat history and only
# the control plane has it. Setting them on a worker does nothing at all.
HERMES_WORKER_OFFLINE_AFTER_SECONDS=120
HERMES_WORKER_RESTARTING_AFTER_SECONDS=45

# How long the control plane waits on a worker before giving up on a request, in
# milliseconds. The health check runs one docker inspection per server on that
# host, so raise this if the worker is slow or running many servers. Must stay
# below the health sync interval.
HERMES_WORKER_REQUEST_TIMEOUT_MS=30000

## Worker only

# Shared secret this worker presents on /api/worker/v1/*. It must match the
# apiToken saved for the worker in the admin page.
#
# That is two copies of one secret with nothing checking they agree, so a
# transcription slip shows up as a 401 on every call and a worker stuck offline.
# While this is unset every worker endpoint answers 503, so the worker cannot be
# driven at all.
HERMES_WORKER_API_TOKEN=
